---
const WORKER_URL = import.meta.env.PUBLIC_WORKER_URL || "http://127.0.0.1:8787";
---
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GM管理画面 | 人狼ゲーム</title>
  <style>
    :root { color-scheme: light dark; --bg:#0f1115; --fg:#eee; --card:#1b1e26; --accent:#c94f4f; --ok:#4caf7d; }
    body { margin:0; min-height:100vh; font-family: system-ui, sans-serif; background:var(--bg); color:var(--fg); }
    .wrap { max-width:560px; margin:0 auto; padding:1.2rem; }
    .card { background:var(--card); border-radius:14px; padding:1.2rem; margin-bottom:1.2rem; }
    h1 { font-size:1.2rem; }
    h2 { font-size:1rem; opacity:0.85; margin-top:0; }
    .code-display { font-size:2.2rem; letter-spacing:0.25em; text-align:center; font-weight:bold;
      color:var(--accent); margin:0.6rem 0; }
    button { padding:0.7rem 1.1rem; border:none; border-radius:10px; font-weight:bold; cursor:pointer; }
    .primary { background:var(--accent); color:white; }
    .secondary { background:#333; color:white; }
    .row { display:flex; gap:0.6rem; flex-wrap:wrap; margin-top:0.6rem; }
    .role-row { display:flex; justify-content:space-between; align-items:center; margin:0.4rem 0; }
    .role-row input { width:60px; padding:0.4rem; border-radius:6px; border:1px solid #444;
      background:#11131a; color:var(--fg); text-align:center; }
    ul.players { list-style:none; padding:0; margin:0; }
    ul.players li { display:flex; justify-content:space-between; align-items:center; background:#11131a;
      padding:0.6rem 0.9rem; border-radius:8px; margin-bottom:0.4rem; font-size:0.9rem; }
    .dead { opacity:0.4; text-decoration:line-through; }
    .kick { background:#4a1f1f; color:#ff9b9b; border:none; border-radius:6px; padding:0.2rem 0.5rem;
      font-size:0.75rem; cursor:pointer; }
    #phaseInfo { font-size:0.95rem; opacity:0.9; }
    #totalWarn { color:#ffb84d; font-size:0.85rem; min-height:1.2em; }
    #setupBox input { width:100%; box-sizing:border-box; padding:0.8rem; border-radius:8px; border:1px solid #444;
      background:#11131a; color:var(--fg); margin-bottom:0.6rem; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>🐺 GM管理画面</h1>

    <div class="card" id="setupBox">
      <h2>新しい部屋を作る</h2>
      <button class="primary" id="createBtn">部屋を作成する</button>
      <h2 style="margin-top:1.2rem">または、既存の部屋コードで管理を再開</h2>
      <input id="resumeCode" placeholder="部屋コード (5文字)" maxlength="5" />
      <input id="resumeToken" placeholder="GMトークン" />
      <button class="secondary" id="resumeBtn">再接続</button>
    </div>

    <div class="card" id="roomBox" style="display:none">
      <h2>この部屋のコード（参加者に伝えてください）</h2>
      <div class="code-display" id="codeDisplay">-----</div>
      <div style="font-size:0.75rem; opacity:0.6; word-break:break-all">GMトークン（このページを再読込した時に必要）: <span id="tokenDisplay"></span></div>
    </div>

    <div class="card" id="roleBox" style="display:none">
      <h2>役職の人数設定</h2>
      <div class="role-row"><span>🐺 人狼</span><input type="number" min="0" id="r_werewolf" value="1" /></div>
      <div class="role-row"><span>🔮 占い師</span><input type="number" min="0" id="r_seer" value="0" /></div>
      <div class="role-row"><span>👻 霊媒師</span><input type="number" min="0" id="r_medium" value="0" /></div>
      <div class="role-row"><span>🏹 狩人</span><input type="number" min="0" id="r_hunter" value="0" /></div>
      <div class="role-row"><span>🃏 狂人</span><input type="number" min="0" id="r_madman" value="0" /></div>
      <div class="role-row"><span>🧑 村人（残り全員）</span><span id="villagerAuto">-</span></div>
      <div id="totalWarn"></div>
      <div class="row">
        <button class="secondary" id="saveRoles">役職設定を保存</button>
        <button class="primary" id="startBtn">ゲーム開始（役職を配る）</button>
      </div>
    </div>

    <div class="card" id="phaseBox" style="display:none">
      <h2>進行管理</h2>
      <div id="phaseInfo">-</div>
      <div class="row">
        <button class="primary" id="advanceBtn">次のフェーズへ進める</button>
        <button class="secondary" id="resetBtn">役職をリセットしてロビーに戻す</button>
      </div>
    </div>

    <div class="card">
      <h2>参加者一覧</h2>
      <ul class="players" id="playerList"></ul>
    </div>
  </div>

  <script define:vars={{ WORKER_URL }}>
    const codeDisplay = document.getElementById("codeDisplay");
    const tokenDisplay = document.getElementById("tokenDisplay");
    const roomBox = document.getElementById("roomBox");
    const roleBox = document.getElementById("roleBox");
    const phaseBox = document.getElementById("phaseBox");
    const playerList = document.getElementById("playerList");
    const phaseInfo = document.getElementById("phaseInfo");
    const totalWarn = document.getElementById("totalWarn");
    const villagerAuto = document.getElementById("villagerAuto");

    const ROLE_LABELS = {
      werewolf: "🐺 人狼", villager: "🧑 村人", seer: "🔮 占い師",
      medium: "👻 霊媒師", hunter: "🏹 狩人", madman: "🃏 狂人",
    };
    const PHASE_LABELS = {
      lobby: "参加者募集中（人数が揃ったら役職を設定してゲーム開始）",
      night: "🌙 夜フェーズ中",
      day: "☀️ 昼（議論）フェーズ中",
      voting: "🗳️ 投票受付中",
      result: "📜 結果発表",
      ended: "🏁 ゲーム終了",
    };

    let code = "", gmToken = "", ws = null, latestState = null;

    function roleInputs() {
      return {
        werewolf: parseInt(document.getElementById("r_werewolf").value) || 0,
        seer: parseInt(document.getElementById("r_seer").value) || 0,
        medium: parseInt(document.getElementById("r_medium").value) || 0,
        hunter: parseInt(document.getElementById("r_hunter").value) || 0,
        madman: parseInt(document.getElementById("r_madman").value) || 0,
      };
    }

    function updateVillagerAuto() {
      const n = latestState ? latestState.players.length : 0;
      const specified = Object.values(roleInputs()).reduce((a, b) => a + b, 0);
      const villagers = Math.max(0, n - specified);
      villagerAuto.textContent = `${villagers}人`;
      totalWarn.textContent = specified > n
        ? `⚠️ 指定した役職の合計(${specified})が参加人数(${n})を超えています`
        : "";
    }
    ["r_werewolf", "r_seer", "r_medium", "r_hunter", "r_madman"].forEach((id) =>
      document.getElementById(id).addEventListener("input", updateVillagerAuto)
    );

    function connectWs() {
      const wsProtocol = WORKER_URL.startsWith("https") ? "wss" : "ws";
      const wsUrl = WORKER_URL.replace(/^https?/, wsProtocol) +
        `/api/room/${code}/ws?role=gm&token=${encodeURIComponent(gmToken)}`;
      ws = new WebSocket(wsUrl);
      ws.onmessage = (evt) => {
        const msg = JSON.parse(evt.data);
        if (msg.type === "state") render(msg);
      };
      ws.onclose = () => setTimeout(connectWs, 1500);
    }

    function enterRoom(c, t) {
      code = c; gmToken = t;
      codeDisplay.textContent = code;
      tokenDisplay.textContent = gmToken;
      roomBox.style.display = "block";
      roleBox.style.display = "block";
      phaseBox.style.display = "block";
      localStorage.setItem("jinro_gm_code", code);
      localStorage.setItem("jinro_gm_token", gmToken);
      connectWs();
    }

    document.getElementById("createBtn").addEventListener("click", async () => {
      const res = await fetch(WORKER_URL + "/api/create-room", { method: "POST" });
      const data = await res.json();
      enterRoom(data.code, data.gmToken);
    });

    document.getElementById("resumeBtn").addEventListener("click", () => {
      const c = document.getElementById("resumeCode").value.trim().toUpperCase();
      const t = document.getElementById("resumeToken").value.trim();
      if (c && t) enterRoom(c, t);
    });

    document.getElementById("saveRoles").addEventListener("click", () => {
      ws.send(JSON.stringify({ type: "set_config", roles: roleInputs() }));
    });
    document.getElementById("startBtn").addEventListener("click", () => {
      ws.send(JSON.stringify({ type: "set_config", roles: roleInputs() }));
      ws.send(JSON.stringify({ type: "start_game" }));
    });
    document.getElementById("advanceBtn").addEventListener("click", () => {
      ws.send(JSON.stringify({ type: "advance_phase" }));
    });
    document.getElementById("resetBtn").addEventListener("click", () => {
      if (confirm("役職をリセットしてロビーに戻します。よろしいですか？")) {
        ws.send(JSON.stringify({ type: "reset" }));
      }
    });

    function render(state) {
      latestState = state;
      updateVillagerAuto();
      phaseInfo.textContent = PHASE_LABELS[state.phase] || state.phase;

      playerList.innerHTML = "";
      for (const p of state.players) {
        const li = document.createElement("li");
        if (!p.alive) li.classList.add("dead");
        const span = document.createElement("span");
        span.textContent = p.name + (p.connected ? "" : "（切断）") +
          (p.role ? `  [${ROLE_LABELS[p.role] || p.role}]` : "");
        li.appendChild(span);
        const kickBtn = document.createElement("button");
        kickBtn.className = "kick";
        kickBtn.textContent = "退出";
        kickBtn.addEventListener("click", () => ws.send(JSON.stringify({ type: "kick", playerId: p.id })));
        li.appendChild(kickBtn);
        playerList.appendChild(li);
      }

      if (state.winner) {
        phaseInfo.textContent += state.winner === "werewolves"
          ? "｜🐺 人狼陣営の勝利！" : "｜🧑 村人陣営の勝利！";
      }
    }

    // ページ再読込時の自動復帰
    const savedCode = localStorage.getItem("jinro_gm_code");
    const savedToken = localStorage.getItem("jinro_gm_token");
    if (savedCode && savedToken) enterRoom(savedCode, savedToken);
  </script>
</body>
</html>
